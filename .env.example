# Optional settings. The app runs fine with none of these set.
#
# There are no API keys here on purpose. AI diagnosis is "bring your own
# key": each user sends their own key with their own request, and the
# server never stores or logs it.

# Render sets PORT automatically. Only needed for local runs.
# PORT=8000

# Limits that protect a small free server (defaults shown).
# LOGDOCTOR_MAX_UPLOAD_BYTES=5242880
# LOGDOCTOR_MAX_PASTE_BYTES=1048576
# LOGDOCTOR_MAX_LINES=50000
# LOGDOCTOR_MAX_CONCURRENT=2
# LOGDOCTOR_RATE_ANALYSES_PER_MIN=20
# LOGDOCTOR_RATE_AI_PER_MIN=5

# Set to true only behind a proxy that sets X-Forwarded-For (Render does; render.yaml sets it).
# LOGDOCTOR_TRUST_PROXY=false

# Websites allowed to call the API from a browser (optional, comma-separated)
# LOGDOCTOR_CORS_ORIGINS=https://yourname.github.io
